MANAGER_HTTP_ADDR=:8080

# Local mode:
DB_DRIVER=sqlite
DB_DSN=/data/manager.db

# Team mode:
POSTGRES_PASSWORD=change-me
WORKER_TOKEN=change-me-worker-token
WORKER_HEARTBEAT_TIMEOUT=90s

WORKER_ID=worker-001
WORKER_NAME=team-worker
WORKER_SUPPORTED_AGENTS=codex,claude
# Local Docker Desktop SSH forwarding for worker Git SSH URLs.
# WORKER_SSH_DIR should point to a directory containing GitHub SSH config/keys.
WORKER_SSH_DIR=/Users/you/.ssh
WORKER_SSH_AUTH_SOCK=/run/host-services/ssh-auth.sock

MANAGER_GRAPHQL_URL=http://localhost:8080/graphql
