scalar Time

enum AgentType {
  codex
  claude
}

enum AgentWorkMode {
  PLAN
  IMPLEMENT
  REVIEW
}

enum CodexReasoningEffort {
  MINIMAL
  LOW
  MEDIUM
  HIGH
  XHIGH
}

enum CodexSandboxMode {
  READ_ONLY
  WORKSPACE_WRITE
  DANGER_FULL_ACCESS
}

enum CodexApprovalPolicy {
  UNTRUSTED
  ON_FAILURE
  ON_REQUEST
  NEVER
}

enum ClaudeEffort {
  LOW
  MEDIUM
  HIGH
  XHIGH
  MAX
}

enum ClaudePermissionMode {
  ACCEPT_EDITS
  AUTO
  BYPASS_PERMISSIONS
  DEFAULT
  DONT_ASK
  PLAN
}

enum TaskStatus {
  CREATED
  ASSIGNED
  STARTING
  RUNNING
  WAITING_INPUT
  INTERRUPTING
  INTERRUPTED
  COMPLETED
  FAILED
  ARCHIVED
}

enum TaskInteractionKind {
  USER_INPUT
  COMMAND_APPROVAL
  FILE_APPROVAL
  PERMISSION_APPROVAL
}

enum TaskInteractionStatus {
  PENDING
  ANSWERED
  CANCELED
}

enum TaskInteractionDecision {
  APPROVE
  APPROVE_FOR_SESSION
  DENY
  CANCEL
}

enum WorkerStatus {
  REGISTERED
  ONLINE
  OFFLINE
  ERROR
  DISABLED
}

enum WorkerProjectBindingMode {
  ALL_PROJECTS
  SPECIFIC_PROJECTS
}

enum BoardType {
  KANBAN
  CALENDAR
  LIST
}

enum SortDirection {
  ASC
  DESC
}

enum TaskSortField {
  CREATED_AT
  UPDATED_AT
  TITLE
  STATUS
  START_DATE
  END_DATE
}

enum ProjectSortField {
  CREATED_AT
  UPDATED_AT
  NAME
  GIT_URL
  DEFAULT_BRANCH
}

enum WorkerSortField {
  CREATED_AT
  UPDATED_AT
  NAME
  STATUS
  LAST_HEARTBEAT_AT
}

enum DomainEventSortField {
  OCCURRED_AT
  EVENT_TYPE
  AGGREGATE_TYPE
  AGGREGATE_ID
}

enum TaskGitDiffScope {
  UNCOMMITTED
  BRANCH
  LAST_TURN
}

enum TaskGitChangeAction {
  STAGE
  UNSTAGE
  DISCARD
  RESTORE
}

enum TaskReviewRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum TaskReviewSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskReviewFindingStatus {
  OPEN
  RESOLVED
  DISMISSED
}

type Task {
  id: ID!
  title: String!
  description: String!
  status: TaskStatus!
  projectId: ID!
  workerId: ID
  agentType: AgentType
  agentConfig: AgentExecutionConfig!
  baseBranch: String!
  worktreePath: String
  agentSessionId: String
  preCommands: [String!]!
  postCommands: [String!]!
  result: String
  startDate: Time!
  endDate: Time!
  version: Int!
  createdAt: Time!
  updatedAt: Time!
}

type AgentExecutionConfig {
  workMode: AgentWorkMode
  codex: CodexExecutionConfig
  claude: ClaudeExecutionConfig
}

type CodexExecutionConfig {
  model: String
  reasoningEffort: CodexReasoningEffort
  sandboxMode: CodexSandboxMode
  approvalPolicy: CodexApprovalPolicy
  fullAuto: Boolean!
  bypassApprovalsAndSandbox: Boolean!
}

type ClaudeExecutionConfig {
  model: String
  effort: ClaudeEffort
  permissionMode: ClaudePermissionMode
}

type TaskConnection {
  nodes: [Task!]!
  totalCount: Int!
}

type ProjectConnection {
  nodes: [Project!]!
  totalCount: Int!
}

type WorkerConnection {
  nodes: [Worker!]!
  totalCount: Int!
}

type DomainEventConnection {
  nodes: [DomainEvent!]!
  totalCount: Int!
}

type TaskLog {
  id: ID!
  taskId: ID!
  stream: String!
  content: String!
  createdAt: Time!
}

type TaskInteraction {
  id: ID!
  taskId: ID!
  kind: TaskInteractionKind!
  status: TaskInteractionStatus!
  title: String!
  body: String!
  rawPayload: String!
  agentSessionId: String
  responseDecision: TaskInteractionDecision
  responseMessage: String
  responsePayload: String!
  createdAt: Time!
  updatedAt: Time!
}

type TaskGitDiff {
  taskId: ID!
  scope: TaskGitDiffScope!
  baseRef: String
  headRef: String
  files: [TaskGitDiffFile!]!
  truncated: Boolean!
  generatedAt: Time!
}

type TaskGitDiffFile {
  path: String!
  oldPath: String
  status: String!
  staged: Boolean!
  additions: Int!
  deletions: Int!
  patch: String!
  truncated: Boolean!
}

type TaskReviewRun {
  id: ID!
  taskId: ID!
  scope: TaskGitDiffScope!
  status: TaskReviewRunStatus!
  agentType: AgentType
  summary: String!
  rawResult: String!
  error: String!
  findings: [TaskReviewFinding!]!
  startedAt: Time
  completedAt: Time
  createdAt: Time!
  updatedAt: Time!
}

type TaskReviewFinding {
  id: ID!
  runId: ID!
  taskId: ID!
  path: String!
  line: Int!
  severity: TaskReviewSeverity!
  status: TaskReviewFindingStatus!
  title: String!
  body: String!
  suggestion: String!
  createdAt: Time!
  updatedAt: Time!
}

type TaskReviewComment {
  id: ID!
  taskId: ID!
  path: String!
  line: Int!
  body: String!
  resolved: Boolean!
  createdAt: Time!
  updatedAt: Time!
}

type TaskGitBackup {
  id: ID!
  taskId: ID!
  paths: [String!]!
  patchPath: String!
  createdAt: Time!
}

type TaskGitChangeResult {
  ok: Boolean!
  backup: TaskGitBackup
  diff: TaskGitDiff
}

type ConversationMessage {
  id: ID!
  taskId: ID!
  role: String!
  content: String!
  metadata: [KeyValue!]!
  createdAt: Time!
}

type Project {
  id: ID!
  name: String!
  gitUrl: String!
  defaultBranch: String!
  worktreeNamePrefix: String!
  archived: Boolean!
  version: Int!
  createdAt: Time!
  updatedAt: Time!
}

type Worker {
  id: ID!
  name: String!
  status: WorkerStatus!
  capabilities: [KeyValue!]!
  supportedAgents: [AgentType!]!
  workDir: String!
  startupCommand: String
  projectBindingMode: WorkerProjectBindingMode!
  boundProjectIds: [ID!]!
  agentRuntimeEnv: [WorkerAgentRuntimeEnv!]!
  currentTaskIds: [ID!]!
  lastHeartbeatAt: Time
  version: Int!
  createdAt: Time!
  updatedAt: Time!
}

type Settings {
  id: ID!
  version: Int!
  workerHeartbeatTimeout: String!
  securityPolicy: String!
  createdAt: Time!
  updatedAt: Time!
}

type WorkerAgentRuntimeEnv {
  agentType: AgentType!
  vars: [AgentRuntimeEnvVar!]!
}

type AgentRuntimeEnvVar {
  key: String!
  valueMasked: String!
  description: String
  enabled: Boolean!
  sensitive: Boolean!
}

type DomainEvent {
  eventId: ID!
  eventType: String!
  aggregateType: String!
  aggregateId: ID!
  aggregateVersion: Int!
  payload: String!
  occurredAt: Time!
  correlationId: String
  causationId: String
}

type OutboxMessage {
  id: ID!
  event: DomainEvent!
  status: String!
  createdAt: Time!
  publishedAt: Time
}

type Board {
  id: ID!
  name: String!
  type: BoardType!
  totalCount: Int!
  columns: [BoardColumn!]!
  calendarItems: [BoardCalendarItem!]!
  tasks: [Task!]!
}

type BoardColumn {
  id: ID!
  title: String!
  status: TaskStatus!
  tasks: [Task!]!
}

type BoardCalendarItem {
  id: ID!
  task: Task!
  date: Time!
  status: TaskStatus!
}

type KeyValue {
  key: String!
  value: String!
}

input PageInput {
  offset: Int
  limit: Int
}

input TaskFilter {
  status: TaskStatus
  projectId: ID
  workerId: ID
  agentType: AgentType
  includeArchived: Boolean
  search: String
}

input WorkerFilter {
  status: WorkerStatus
  projectId: ID
  agentType: AgentType
  includeDisabled: Boolean
  search: String
}

input ProjectFilter {
  includeArchived: Boolean
  search: String
}

input DomainEventFilter {
  aggregateId: ID
  aggregateType: String
  eventType: String
  search: String
}

input TaskSortInput {
  field: TaskSortField
  direction: SortDirection
}

input ProjectSortInput {
  field: ProjectSortField
  direction: SortDirection
}

input WorkerSortInput {
  field: WorkerSortField
  direction: SortDirection
}

input DomainEventSortInput {
  field: DomainEventSortField
  direction: SortDirection
}

input CreateTaskInput {
  title: String!
  description: String
  projectId: ID!
  workerId: ID
  agentType: AgentType
  agentConfig: AgentExecutionConfigInput
  baseBranch: String
  preCommands: [String!]
  postCommands: [String!]
  startDate: Time
  endDate: Time
}

input UpdateTaskInput {
  id: ID!
  title: String!
  description: String
  projectId: ID!
  agentType: AgentType
  baseBranch: String
  preCommands: [String!]
  postCommands: [String!]
  startDate: Time
  endDate: Time
}

input AssignWorkerInput {
  taskId: ID!
  workerId: ID!
  agentType: AgentType
  agentConfig: AgentExecutionConfigInput
}

input AgentExecutionConfigInput {
  workMode: AgentWorkMode
  codex: CodexExecutionConfigInput
  claude: ClaudeExecutionConfigInput
}

input CodexExecutionConfigInput {
  model: String
  reasoningEffort: CodexReasoningEffort
  sandboxMode: CodexSandboxMode
  approvalPolicy: CodexApprovalPolicy
  fullAuto: Boolean
  bypassApprovalsAndSandbox: Boolean
}

input ClaudeExecutionConfigInput {
  model: String
  effort: ClaudeEffort
  permissionMode: ClaudePermissionMode
}

input StartTaskInput {
  taskId: ID!
}

input ContinueTaskInput {
  taskId: ID!
  message: String!
}

input StartTaskReviewInput {
  taskId: ID!
  scope: TaskGitDiffScope!
}

input AddTaskReviewCommentInput {
  taskId: ID!
  path: String!
  line: Int!
  body: String!
}

input TaskGitChangeInput {
  taskId: ID!
  paths: [String!]
  patch: String
  backupId: ID
}

input ContinueTaskWithReviewFeedbackInput {
  taskId: ID!
  findingIds: [ID!]
  commentIds: [ID!]
  message: String
}

input RespondTaskInteractionInput {
  interactionId: ID!
  decision: TaskInteractionDecision
  message: String
  payload: String
}

input CreateWorkerInput {
  id: ID
  name: String!
  supportedAgents: [AgentType!]!
  workDir: String!
  startupCommand: String
  projectBindingMode: WorkerProjectBindingMode
  boundProjectIds: [ID!]
  agentRuntimeEnv: [WorkerAgentRuntimeEnvInput!]
  capabilities: [KeyValueInput!]
}

input RegisterWorkerInput {
  id: ID
  name: String!
  supportedAgents: [AgentType!]!
  workDir: String!
  startupCommand: String
  projectBindingMode: WorkerProjectBindingMode
  boundProjectIds: [ID!]
  agentRuntimeEnv: [WorkerAgentRuntimeEnvInput!]
  capabilities: [KeyValueInput!]
}

input UpdateWorkerInput {
  id: ID!
  name: String!
  supportedAgents: [AgentType!]!
  workDir: String!
  startupCommand: String
  projectBindingMode: WorkerProjectBindingMode!
  boundProjectIds: [ID!]
  agentRuntimeEnv: [WorkerAgentRuntimeEnvInput!]
  capabilities: [KeyValueInput!]
}

input UpdateWorkerProjectBindingsInput {
  workerId: ID!
  projectBindingMode: WorkerProjectBindingMode!
  boundProjectIds: [ID!]
}

input CreateProjectInput {
  name: String!
  gitUrl: String!
  defaultBranch: String
  worktreeNamePrefix: String
}

input UpdateProjectInput {
  id: ID!
  name: String!
  gitUrl: String!
  defaultBranch: String!
  worktreeNamePrefix: String!
}

input AgentRuntimeEnvVarInput {
  key: String!
  value: String
  description: String
  enabled: Boolean!
  sensitive: Boolean!
}

input WorkerAgentRuntimeEnvInput {
  agentType: AgentType!
  vars: [AgentRuntimeEnvVarInput!]!
}

input KeyValueInput {
  key: String!
  value: String!
}

type Query {
  task(id: ID!): Task
  tasks(filter: TaskFilter, sort: TaskSortInput, page: PageInput): TaskConnection!
  taskList(filter: TaskFilter, sort: TaskSortInput, page: PageInput): [Task!]!
  worker(id: ID!): Worker
  workers(filter: WorkerFilter, sort: WorkerSortInput): [Worker!]!
  workersConnection(filter: WorkerFilter, sort: WorkerSortInput, page: PageInput): WorkerConnection!
  project(id: ID!): Project
  projects(filter: ProjectFilter, sort: ProjectSortInput): [Project!]!
  projectsConnection(filter: ProjectFilter, sort: ProjectSortInput, page: PageInput): ProjectConnection!
  board(id: ID, filter: TaskFilter, sort: TaskSortInput, page: PageInput): Board!
  settings: Settings!
  taskEvents(taskId: ID!): [DomainEvent!]!
  domainEvents(filter: DomainEventFilter, sort: DomainEventSortInput, aggregateId: ID, aggregateType: String, eventType: String): [DomainEvent!]!
  domainEventsConnection(filter: DomainEventFilter, sort: DomainEventSortInput, aggregateId: ID, aggregateType: String, eventType: String, page: PageInput): DomainEventConnection!
  outboxMessages(includePublished: Boolean): [OutboxMessage!]!
  taskLogs(taskId: ID!): [TaskLog!]!
  taskConversations(taskId: ID!): [ConversationMessage!]!
  taskInteractions(taskId: ID!, status: TaskInteractionStatus): [TaskInteraction!]!
  taskGitDiff(taskId: ID!, scope: TaskGitDiffScope!, staged: Boolean): TaskGitDiff!
  taskReviewRuns(taskId: ID!): [TaskReviewRun!]!
  taskReviewFindings(taskId: ID!, status: TaskReviewFindingStatus): [TaskReviewFinding!]!
  taskReviewComments(taskId: ID!): [TaskReviewComment!]!
  taskGitBackups(taskId: ID!): [TaskGitBackup!]!
}

type Mutation {
  createTask(input: CreateTaskInput!): Task!
  updateTask(input: UpdateTaskInput!): Task!
  assignWorker(input: AssignWorkerInput, taskId: ID, workerId: ID): Task!
  startTask(input: StartTaskInput, taskId: ID, id: ID): Task!
  continueTask(input: ContinueTaskInput!): Task!
  respondTaskInteraction(input: RespondTaskInteractionInput!): TaskInteraction!
  interruptTask(taskId: ID, id: ID): Task!
  archiveTask(taskId: ID, id: ID): Task!
  deleteTask(taskId: ID, id: ID): Boolean!
  retryTask(taskId: ID, id: ID): Task!
  startTaskReview(input: StartTaskReviewInput!): TaskReviewRun!
  addTaskReviewComment(input: AddTaskReviewCommentInput!): TaskReviewComment!
  stageTaskGitChanges(input: TaskGitChangeInput!): TaskGitChangeResult!
  unstageTaskGitChanges(input: TaskGitChangeInput!): TaskGitChangeResult!
  discardTaskGitChanges(input: TaskGitChangeInput!): TaskGitChangeResult!
  restoreTaskGitBackup(input: TaskGitChangeInput!): TaskGitChangeResult!
  resolveTaskReviewFinding(id: ID!): TaskReviewFinding!
  dismissTaskReviewFinding(id: ID!): TaskReviewFinding!
  continueTaskWithReviewFeedback(input: ContinueTaskWithReviewFeedbackInput!): Task!

  createWorker(input: CreateWorkerInput!): Worker!
  registerWorker(input: RegisterWorkerInput!): Worker!
  updateWorker(input: UpdateWorkerInput!): Worker!
  updateWorkerProjectBindings(input: UpdateWorkerProjectBindingsInput!): Worker!
  enableWorker(id: ID!): Worker!
  disableWorker(id: ID!): Worker!
  deleteWorker(id: ID!): Boolean!

  createProject(input: CreateProjectInput!): Project!
  updateProject(input: UpdateProjectInput!): Project!
  archiveProject(id: ID!): Project!

  updateWorkerHeartbeatTimeout(timeout: String!): Settings!
}

type Subscription {
  taskUpdated(taskId: ID!): DomainEvent!
  taskLogAppended(taskId: ID!): TaskLog!
  taskConversationAppended(taskId: ID!): ConversationMessage!
  workerUpdated(workerId: ID): DomainEvent!
  domainEvents(filter: DomainEventFilter): DomainEvent!
}
